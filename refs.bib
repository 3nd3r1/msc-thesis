  author = {Besta, Maciej and Jarmocik, {\L}ukasz and Hrycyna, Orest and Klaiman, Shachar and M{\k a}czka, Konrad and Gerstenberger, Robert and M{\"u}ller, J{\"u}rgen and Nyczyk, Piotr and Niewiadomski, Hubert and Hoefler, Torsten},
