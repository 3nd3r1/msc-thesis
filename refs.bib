@misc{zhaoLarchLearnedQuery2026,
  title = {Larch: {{Learned Query Optimization}} for {{Semantic Predicates}}},
  shorttitle = {Larch},
  author = {Zhao, Fuheng and Liskowski, Pawel and Li, Zihan and Han, Benjamin and Yu, Puxuan and Boonsanong, Varich and Tsirogiannis, Dimitris and Datta, Anupam},
